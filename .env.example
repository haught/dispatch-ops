# Copy to .env for local development (`make setup-env`). The Makefile and the
# Tiltfile load it.

# Your Postgres, outside the cluster (`make db-init` creates the role and
# databases in the container PG_CONTAINER, default "postgresql"). Job and
# server pods in kind reach localhost ports at host.docker.internal; the
# Tiltfile rewrites the host for them.
DISPATCH_DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch?sslmode=disable

# Encrypts credentials. Dev only; generate a real one with `dispatch-ops gen-key`.
# Keep it as long as you keep the database, or stored credentials are lost.
DISPATCH_ENCRYPTION_KEY=ZGV2LW9ubHktZGlzcGF0Y2gtb3BzLWtleS0zMmJ5dGU=
# DISPATCH_OLD_ENCRYPTION_KEYS=

# Logs and CLI targets (`make migrate`, `make admin`) run on the host.
DISPATCH_LOG_LEVEL=debug
DISPATCH_LOG_FORMAT=text
DISPATCH_SESSION_TTL=12h

# Single sign-on (optional). Register $DISPATCH_EXTERNAL_URL/api/v1/auth/oidc/callback
# as the client's redirect URI.
DISPATCH_EXTERNAL_URL=http://localhost:8080
# DISPATCH_OIDC_ISSUER=https://idp.example.com/realms/dispatch
# DISPATCH_OIDC_CLIENT_ID=dispatch-ops
# DISPATCH_OIDC_CLIENT_SECRET=
# DISPATCH_OIDC_SCOPES=profile,email,groups
