# Copy to .env for local development (`make setup-env`). The Makefile and the
# Tiltfile load it.

# Your Postgres, a container on the host's Docker outside the cluster
# (`make db-init` creates the role and databases in the container
# PG_CONTAINER, default "postgresql"). The dev container and pods in kind
# both reach its published port at host.docker.internal.
DISPATCH_DATABASE_URL=postgres://dispatch:dispatch@host.docker.internal:5432/dispatch?sslmode=disable

# Encrypts credentials. `make setup-env` fills in a new random key (or run
# `go run ./cmd/dispatch-ops gen-key`). Keep it as long as you keep the
# database, or stored credentials are lost. To change it, move the old key
# to DISPATCH_OLD_ENCRYPTION_KEYS.
DISPATCH_ENCRYPTION_KEY=
# DISPATCH_OLD_ENCRYPTION_KEYS=

# Logs, and the CLI targets (`make migrate`, `make admin`) in the dev container.
DISPATCH_LOG_LEVEL=debug
DISPATCH_LOG_FORMAT=text
DISPATCH_SESSION_TTL=12h

# Single sign-on (optional). Register $DISPATCH_EXTERNAL_URL/api/v1/auth/oidc/callback
# as the client's redirect URI.
DISPATCH_EXTERNAL_URL=https://localhost:8443
# DISPATCH_OIDC_ISSUER=https://idp.example.com/realms/dispatch
# DISPATCH_OIDC_CLIENT_ID=dispatch-ops
# DISPATCH_OIDC_CLIENT_SECRET=
# DISPATCH_OIDC_SCOPES=profile,email,groups
