# Copy to .env for local development (`make setup-env`). The Makefile loads it.
DISPATCH_DATABASE_URL=postgres://dispatch:dispatch@localhost:5433/dispatch?sslmode=disable
DISPATCH_LISTEN_ADDR=:8080
# Plain HTTP locally, so the session cookie can't be Secure.
DISPATCH_SECURE_COOKIES=false
DISPATCH_SESSION_TTL=12h
DISPATCH_AUTO_MIGRATE=false
DISPATCH_LOG_LEVEL=debug
DISPATCH_LOG_FORMAT=text

# Encrypts credentials. Dev only; generate a real one with `dispatch-ops gen-key`.
DISPATCH_ENCRYPTION_KEY=ZGV2LW9ubHktZGlzcGF0Y2gtb3BzLWtleS0zMmJ5dGU=

# Single sign-on (optional). Register $DISPATCH_EXTERNAL_URL/api/v1/auth/oidc/callback
# as the client's redirect URI.
DISPATCH_EXTERNAL_URL=http://localhost:8080
# DISPATCH_OIDC_ISSUER=https://idp.example.com/realms/dispatch
# DISPATCH_OIDC_CLIENT_ID=dispatch-ops
# DISPATCH_OIDC_CLIENT_SECRET=
# DISPATCH_OIDC_SCOPES=profile,email,groups

# Task manager (`make task-manager`): run jobs on the kind cluster from `make kind-up`.
DISPATCH_KUBE_CONTEXT=kind-dispatch-ops
DISPATCH_JOB_NAMESPACE=dispatch-jobs
# How job pods reach the API server on the host (Docker Desktop).
DISPATCH_RUNNER_API_URL=http://host.docker.internal:8080
DISPATCH_MAX_CONCURRENT_JOBS=5
